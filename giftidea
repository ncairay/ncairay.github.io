<!DOCTYPE html>
<html lang="zh-HK">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GiftIdea - AI 送禮 App</title>
<style>
  :root { --purple:#7F77DD; --purpledark:#5B54B8; }
  * { margin:0; padding:0; box-sizing:border-box; }
  body {
    font-family:-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    background:linear-gradient(160deg,#faf9ff 0%,#efeaff 100%);
    color:#2b2b3a; min-height:100vh;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:32px 24px; text-align:center;
  }
  .gift { font-size:64px; margin-bottom:12px; }
  h1 { font-size:2rem; color:var(--purpledark); margin-bottom:6px; }
  .sub { color:#6b6b7d; margin-bottom:36px; font-size:1rem; line-height:1.5; }
  .btns { display:flex; flex-direction:column; gap:14px; width:100%; max-width:320px; }
  a.store {
    display:block; padding:16px 20px; border-radius:14px; text-decoration:none;
    font-weight:600; font-size:1.05rem; transition:transform .15s, box-shadow .15s;
  }
  a.store:hover { transform:translateY(-2px); box-shadow:0 8px 22px rgba(127,119,221,.28); }
  .ios { background:var(--purple); color:#fff; }
  .android { background:#fff; color:var(--purpledark); border:2px solid var(--purple); }
  .redir { margin-top:28px; color:#9a9aad; font-size:.85rem; }
  footer { margin-top:40px; color:#b3b3c2; font-size:.75rem; }
</style>
</head>
<body>
  <div class="gift">🎁</div>
  <h1>GiftIdea</h1>
  <p class="sub">唔知送咩好？等 AI 幫你諗。<br>Not sure what gift to give? Let AI help.</p>
  <div class="btns">
    <a class="store ios" id="iosBtn" href="https://apps.apple.com/app/id6772551453">📱 App Store（iPhone）</a>
    <a class="store android" id="androidBtn" href="https://play.google.com/store/apps/details?id=com.ncaism.giftidea">🤖 Google Play（Android）</a>
  </div>
  <p class="redir" id="redirMsg"></p>
  <footer>NCAISM · ncairay.github.io</footer>

<script>
  var ios = "https://apps.apple.com/app/id6772551453";
  var android = "https://play.google.com/store/apps/details?id=com.ncaism.giftidea";
  var ua = navigator.userAgent || navigator.vendor || "";
  var isIOS = /iPad|iPhone|iPod/.test(ua) && !window.MSStream;
  var isAndroid = /android/i.test(ua);
  if (isIOS) {
    document.getElementById("redirMsg").textContent = "正在帶你去 App Store…";
    setTimeout(function(){ window.location.href = ios; }, 700);
  } else if (isAndroid) {
    document.getElementById("redirMsg").textContent = "正在帶你去 Google Play…";
    setTimeout(function(){ window.location.href = android; }, 700);
  } else {
    document.getElementById("redirMsg").textContent = "揀你部機嘅平台下載 👆";
  }
</script>
</body>
</html>
